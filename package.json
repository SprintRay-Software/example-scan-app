{
  "name": "scanpro-simulator",
  "version": "0.0.2",
  "private": true,
  "type": "module",
  "main": "electron/main.js",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "scanpro-sim": "src/index.js"
  },
  "scripts": {
    "app": "electron . --env-file=.env.dev",
    "app:dev": "electron . --env-file=.env.dev",
    "app:staging": "electron . --env-file=.env.staging",
    "app:prod": "electron . --env-file=.env.prod",
    "start": "node --env-file=.env src/index.js",
    "start:staging": "node --env-file=.env.staging src/index.js",
    "serve": "node --env-file-if-exists=.env src/index.js serve",
    "register": "node --env-file-if-exists=.env src/index.js register",
    "unregister": "node --env-file-if-exists=.env src/index.js unregister",
    "status": "node --env-file-if-exists=.env src/index.js status",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win --x64",
    "dist:mac": "electron-builder --mac --arm64"
  },
  "build": {
    "appId": "com.sprintray.scanpro.example",
    "productName": "ScanPro Integration Example",
    "copyright": "Copyright © SprintRay",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "afterPack": "build/after-pack.cjs",
    "artifactName": "${name}-${version}-${os}-${arch}.${ext}",
    "files": [
      "electron/**/*",
      "src/**/*",
      "fixtures/**/*",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "fixtures/**"
    ],
    "protocols": [
      {
        "name": "SprintRay ScanPro launch",
        "schemes": [
          "openScanPro"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "ScanPro Integration Example"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "identity": null
    },
    "dmg": {
      "writeUpdateInfo": false
    },
    "publish": null
  },
  "devDependencies": {
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3"
  }
}