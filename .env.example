# Copy this file to .env and fill in the values. .env is gitignored — never commit real secrets.
# Both the CLI (npm start) and the desktop UI (npm run app) read these; the UI prefills its
# config fields from here and lets you edit them per run.

# SprintRay API gateway ORIGIN (origin only — gateway paths do NOT carry an /api prefix).
# Production: https://apx.sprintray.com — dev is https://dev-apx.sprintray.com.
# SprintRay provides the origin for your environment.
SCANPRO_BASE_URL=https://apx.sprintray.com

# The API-gateway key SprintRay issues for your integration, sent as the x-api-key header on
# every call to SprintRay. It is not the client id or the client secret: the API key identifies
# the caller and selects its usage plan, while the client credentials exchange the device-login
# code for the doctor's token. Without it the gateway answers 403 before the backend is reached.
SCANPRO_API_KEY=your-gateway-api-key

# Your integration's client credentials, issued to you by SprintRay.
SCANPRO_CLIENT_ID=your-integration-client-id
SCANPRO_CLIENT_SECRET=your-integration-client-secret

# ── Your scan vocabulary ────────────────────────────────────────────────────────────
# Your own names for what you scan — not SprintRay enums. Every upload names the scan type it
# carries (externalScanFileType) and the finish call names the mode (scanMode). SprintRay
# registers a name it has not seen against your integration on first sight, and an admin maps it
# once to the matching SprintRay file type / indication; from then on that mapping is what
# decides the type of every file uploaded under the name. Casing is not significant when
# matching, but the first spelling SprintRay sees is the one it keeps — spell it the same way
# every time, and hand the list of names over during onboarding rather than letting the first
# upload introduce them. All optional; these defaults are what this example calls its own.
SCANPRO_SCAN_MODE=quickScan
SCANPRO_SCAN_FILE_TYPE_UPPER=UpperArch
SCANPRO_SCAN_FILE_TYPE_LOWER=LowerArch

# The custom URL scheme your desktop app registers with the OS. Must match the scheme
# SprintRay configured for your integration. Used by register / status / unregister.
SCANPRO_URL_SCHEME=openScanPro

# ── Desktop UI ──────────────────────────────────────────────────────────────────────
# Which skin the Electron app opens in:
#   demo (default) — the chairside scanner UI: idle until a launch payload arrives, then it
#                    plays that case, really sends it (with the credentials above), and steps
#                    aside so the browser is in front again
#   dev            — the instrumented inspector: config fields, pipeline, full HTTP traffic
# Either way, pressing d five times switches between them at runtime.
SCANPRO_UI_MODE=demo

# ── Local HTTP service (127.0.0.1) ──────────────────────────────────────────────────
# The second launch transport: the web app probes the port range for a resident service
# and calls it instead of going through the URL scheme. Every setting below is optional —
# the service comes up with these defaults if the whole block is missing.

# Set to 0 to keep the desktop UI from starting the service at all.
SCANPRO_LOCAL_SERVER=1

# Port range to scan, low to high. The first port that binds wins. Keep the defaults
# unless SprintRay tells you otherwise — the web side probes exactly this range.
SCANPRO_LOCAL_SERVER_PORT_START=29083
SCANPRO_LOCAL_SERVER_PORT_END=29183

# Comma-separated CORS allowlist. Empty (the default) echoes whatever Origin asks, which
# is the easiest to test with; set it to lock the service to the SprintRay web app.
SCANPRO_LOCAL_SERVER_ORIGINS=

# Version string GET /scanpro/v1/status reports. Defaults to this app's own version.
SCANPRO_REPORTED_VERSION=

# ── Telemetry ───────────────────────────────────────────────────────────────────────
# Used for one event: local_server.port_unavailable, when the whole port range is taken
# and the service cannot start. Without both values the event is only logged locally.
# SprintRay issues the endpoint and the key for your environment.
SCANPRO_TELEMETRY_URL=
SCANPRO_TELEMETRY_API_KEY=
# release | beta | internal | dev — lets SprintRay exclude test traffic from dashboards.
SCANPRO_TELEMETRY_CHANNEL=dev
