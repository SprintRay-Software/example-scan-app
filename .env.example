# Copy this file to .env and fill in the values. .env is gitignored — never commit real secrets.
# Both the CLI (npm start) and the desktop UI (npm run app) read these; the UI prefills its
# config fields from here and lets you edit them per run.

# SprintRay backend ORIGIN (no /api suffix; API paths already include /api).
# Production: https://dashboard.sprintray.com — SprintRay provides the origin for your environment.
SCANPRO_BASE_URL=https://dashboard.sprintray.com

# Your integration's client credentials, issued to you by SprintRay.
SCANPRO_CLIENT_ID=your-integration-client-id
SCANPRO_CLIENT_SECRET=your-integration-client-secret

# The custom URL scheme your desktop app registers with the OS. Must match the scheme
# SprintRay configured for your integration. Used by register / status / unregister.
SCANPRO_URL_SCHEME=openScanPro
