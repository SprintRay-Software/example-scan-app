# Copy this file to .env and fill in the values. .env is gitignored — never commit real secrets.
# Both the CLI (npm start) and the desktop UI (npm run app) read these; the UI prefills its
# config fields from here and lets you edit them per run.

# SprintRay backend ORIGIN (no /api suffix; API paths already include /api).
# Production: https://dashboard.sprintray.com — SprintRay provides the origin for your environment.
SCANPRO_BASE_URL=https://dashboard.sprintray.com

# Your integration's client credentials, issued to you by SprintRay.
SCANPRO_CLIENT_ID=your-integration-client-id
SCANPRO_CLIENT_SECRET=your-integration-client-secret

# The custom URL scheme your desktop app registers with the OS. Must match the scheme
# SprintRay configured for your integration. Used by register / status / unregister.
SCANPRO_URL_SCHEME=openScanPro

# ── Local HTTP service (127.0.0.1) ──────────────────────────────────────────────────
# The second launch transport: the web app probes the port range for a resident service
# and calls it instead of going through the URL scheme. Every setting below is optional —
# the service comes up with these defaults if the whole block is missing.

# Set to 0 to keep the desktop UI from starting the service at all.
SCANPRO_LOCAL_SERVER=1

# Port range to scan, low to high. The first port that binds wins. Keep the defaults
# unless SprintRay tells you otherwise — the web side probes exactly this range.
SCANPRO_LOCAL_SERVER_PORT_START=29083
SCANPRO_LOCAL_SERVER_PORT_END=29183

# Comma-separated CORS allowlist. Empty (the default) echoes whatever Origin asks, which
# is the easiest to test with; set it to lock the service to the SprintRay web app.
SCANPRO_LOCAL_SERVER_ORIGINS=

# Version string GET /scanpro/v1/status reports. Defaults to this app's own version.
SCANPRO_REPORTED_VERSION=

# ── Telemetry ───────────────────────────────────────────────────────────────────────
# Used for one event: local_server.port_unavailable, when the whole port range is taken
# and the service cannot start. Without both values the event is only logged locally.
# SprintRay issues the endpoint and the key for your environment.
SCANPRO_TELEMETRY_URL=
SCANPRO_TELEMETRY_API_KEY=
# release | beta | internal | dev — lets SprintRay exclude test traffic from dashboards.
SCANPRO_TELEMETRY_CHANNEL=dev
