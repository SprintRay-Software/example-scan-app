# Local dev env (contains the client secret and the gateway API key).
# Cover sibling copies too — a .env.bak / .env.local holds the same secrets.
.env
.env.*
!.env.example

# Dependencies (Electron is a devDependency; the CLI stays zero-dependency)
node_modules

# Packaged builds (electron-builder output)
release

# OS junk
.DS_Store
